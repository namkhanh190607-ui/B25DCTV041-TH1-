/* BIẾN MÀU SẮC (LIGHT & DARK MODE) */
:root {
  --bg-color: #ffffff;
  --bg-alt: #f4f6f9;
  --card-bg: #ffffff;
  --text-color: #1e293b;
  --text-muted: #64748b;
  --primary: #2563eb;
  --primary-hover: #1d4ed8;
  --border-color: #e2e8f0;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.06);
  --danger: #dc2626;
  --success: #16a34a;
}

[data-theme="dark"] {
  --bg-color: #0f172a;
  --bg-alt: #1e293b;
  --card-bg: #1e293b;
  --text-color: #f1f5f9;
  --text-muted: #94a3b8;
  --primary: #3b82f6;
  --primary-hover: #60a5fa;
  --border-color: #334155;
  --shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
}

/* RESET & CƠ BẢN */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  background-color: var(--bg-color);
  color: var(--text-color);
  line-height: 1.6;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.container {
  width: 90%;
  max-width: 1100px;
  margin: 0 auto;
}

.section {
  padding: 80px 0;
}

.section-alt {
  background-color: var(--bg-alt);
}

.section-title {
  text-align: center;
  font-size: 2rem;
  margin-bottom: 40px;
}

/* HEADER & NAVIGATION (FLEXBOX) */
.header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background-color: var(--bg-color);
  border-bottom: 1px solid var(--border-color);
}

.nav-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 70px;
}

.logo {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--text-color);
  text-decoration: none;
}

.logo span {
  color: var(--primary);
}

.nav-list {
  display: flex;
  list-style: none;
  gap: 28px;
}

.nav-link {
  text-decoration: none;
  color: var(--text-color);
  font-weight: 500;
  transition: color 0.2s ease;
}

.nav-link:hover {
  color: var(--primary);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.icon-btn {
  background: var(--bg-alt);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 6px 10px;
  font-size: 1.1rem;
  cursor: pointer;
  transition: transform 0.2s ease, background-color 0.2s ease;
}

.icon-btn:hover {
  transform: scale(1.08);
}

/* HAMBURGER MENU */
.hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
}

.hamburger span {
  width: 24px;
  height: 3px;
  background-color: var(--text-color);
  border-radius: 2px;
  transition: 0.3s;
}

/* HERO / GIỚI THIỆU (FLEXBOX) */
.hero-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
}

.hero-content {
  flex: 1;
}

.badge {
  display: inline-block;
  background-color: rgba(37, 99, 235, 0.12);
  color: var(--primary);
  padding: 4px 12px;
  border-radius: 20px;
  font-weight: 600;
  font-size: 0.9rem;
  margin-bottom: 12px;
}

.hero-content h1 {
  font-size: 2.8rem;
  line-height: 1.2;
  margin-bottom: 8px;
}

.hero-content h2 {
  font-size: 1.3rem;
  color: var(--text-muted);
  font-weight: 500;
  margin-bottom: 16px;
}

.hero-desc {
  color: var(--text-muted);
  margin-bottom: 24px;
  max-width: 540px;
}

.hero-buttons {
  display: flex;
  gap: 14px;
}

.btn {
  display: inline-block;
  padding: 10px 22px;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  border: 2px solid transparent;
  transition: all 0.25s ease;
}

.btn-primary {
  background-color: var(--primary);
  color: #ffffff;
}

.btn-primary:hover {
  background-color: var(--primary-hover);
  transform: translateY(-2px);
}

.btn-outline {
  border-color: var(--primary);
  color: var(--primary);
  background: transparent;
}

.btn-outline:hover {
  background-color: var(--primary);
  color: #ffffff;
  transform: translateY(-2px);
}

.avatar-circle {
  width: 240px;
  height: 240px;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #06b6d4);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 3.2rem;
  font-weight: 700;
  box-shadow: var(--shadow);
}

/* KỸ NĂNG (CSS GRID) */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.skill-card {
  background-color: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 24px;
  box-shadow: var(--shadow);
  transition: transform 0.25s ease, border-color 0.25s ease;
}

.skill-card:hover {
  transform: translateY(-6px);
  border-color: var(--primary);
}

.skill-card h3 {
  margin-bottom: 10px;
  font-size: 1.15rem;
}

.skill-card p {
  color: var(--text-muted);
  font-size: 0.92rem;
  margin-bottom: 16px;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.skill-tags span {
  background-color: var(--bg-alt);
  border: 1px solid var(--border-color);
  padding: 3px 10px;
  border-radius: 6px;
  font-size: 0.8rem;
  font-weight: 500;
}

/* DỰ ÁN (CSS GRID + FILTER) */
.project-controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 30px;
}

#project-search {
  flex: 1;
  min-width: 240px;
  padding: 10px 14px;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  background-color: var(--card-bg);
  color: var(--text-color);
  font-size: 0.95rem;
}

.filter-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.filter-btn {
  padding: 8px 16px;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  background-color: var(--card-bg);
  color: var(--text-color);
  cursor: pointer;
  font-weight: 500;
  transition: all 0.2s ease;
}

.filter-btn:hover,
.filter-btn.active {
  background-color: var(--primary);
  color: #ffffff;
  border-color: var(--primary);
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.project-card {
  background-color: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.project-card:hover {
  transform: translateY(-6px);
}

.project-card.hidden {
  display: none;
}

.project-thumb {
  height: 140px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 1.4rem;
  font-weight: 700;
}

.thumb-1 { background: linear-gradient(135deg, #2563eb, #4f46e5); }
.thumb-2 { background: linear-gradient(135deg, #059669, #10b981); }
.thumb-3 { background: linear-gradient(135deg, #d97706, #f59e0b); }
.thumb-4 { background: linear-gradient(135deg, #0284c7, #38bdf8); }

.project-body {
  padding: 22px;
}

.project-tag {
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--primary);
  text-transform: uppercase;
}

.project-body h3 {
  margin: 6px 0 10px;
}

.project-body p {
  color: var(--text-muted);
  font-size: 0.94rem;
  margin-bottom: 12px;
}

.project-tech {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 14px;
}

.project-link {
  color: var(--primary);
  text-decoration: none;
  font-weight: 600;
}

.project-link:hover {
  text-decoration: underline;
}

.no-results {
  text-align: center;
  color: var(--text-muted);
  margin-top: 20px;
}

/* FORM LIÊN HỆ */
.contact-container {
  max-width: 620px;
}

.contact-form {
  background-color: var(--card-bg);
  padding: 32px;
  border-radius: 12px;
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow);
}

.form-group {
  margin-bottom: 18px;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-group label {
  display: block;
  font-weight: 600;
  margin-bottom: 6px;
}

.char-count {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 10px 14px;
  border: 1px solid var(--border-color);
  border-radius: 8px;
  background-color: var(--bg-color);
  color: var(--text-color);
  font-family: inherit;
  font-size: 0.95rem;
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--primary);
}

.error-msg {
  display: block;
  color: var(--danger);
  font-size: 0.85rem;
  margin-top: 4px;
  min-height: 18px;
}

.success-msg {
  color: var(--success);
  font-weight: 600;
  text-align: center;
  margin-top: 14px;
}

.btn-full {
  width: 100%;
  font-size: 1rem;
}

.hidden {
  display: none;
}

/* FOOTER */
.footer {
  border-top: 1px solid var(--border-color);
  padding: 24px 0;
}

.footer-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}

.social-links {
  display: flex;
  gap: 18px;
}

.social-links a {
  color: var(--text-muted);
  text-decoration: none;
  transition: color 0.2s ease;
}

.social-links a:hover {
  color: var(--primary);
}

/* SCROLL REVEAL ANIMATION */
.reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}

.reveal.active {
  opacity: 1;
  transform: translateY(0);
}

/* =========================================
   RESPONSIVE BREAKPOINT 1: TABLET (<= 992px)
   ========================================= */
@media (max-width: 992px) {
  .skills-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .hero-content h1 {
    font-size: 2.3rem;
  }

  .avatar-circle {
    width: 200px;
    height: 200px;
    font-size: 2.6rem;
  }
}

/* =========================================
   RESPONSIVE BREAKPOINT 2: MOBILE (<= 600px)
   ========================================= */
@media (max-width: 600px) {
  .hamburger {
    display: flex;
  }

  .nav-menu {
    position: absolute;
    top: 70px;
    left: 0;
    width: 100%;
    background-color: var(--bg-color);
    border-bottom: 1px solid var(--border-color);
    display: none;
    padding: 16px 0;
  }

  .nav-menu.active {
    display: block;
  }

  .nav-list {
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .hero-container {
    flex-direction: column-reverse;
    text-align: center;
  }

  .hero-buttons {
    justify-content: center;
  }

  .skills-grid,
  .projects-grid {
    grid-template-columns: 1fr;
  }

  .footer-container {
    flex-direction: column;
    text-align: center;
  }
}
